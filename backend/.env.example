ENVIRONMENT=development
PROJECT_NAME="EstateMap AI"
API_V1_STR="/api/v1"

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://estatemap:estatemap_dev_password@localhost:5432/estatemap_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=insecure_dev_jwt_secret_key_change_in_production_min_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Configuration
AI_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
