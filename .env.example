# ==============================================================================
# EstateMap AI — Root Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="EstateMap AI"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=estatemap
POSTGRES_PASSWORD=estatemap_dev_password
POSTGRES_DB=estatemap_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://estatemap:estatemap_dev_password@localhost:5432/estatemap_db

# Redis Configuration (Cache & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_COORDINATE_PRECISION=4
CACHE_ROUTE_TTL_SECONDS=600
CACHE_POI_TTL_SECONDS=1800
CACHE_MAP_TTL_SECONDS=120
CACHE_RANKING_TTL_SECONDS=300

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_RANKED_SEARCH_REQUESTS=20
RATE_LIMIT_RANKED_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_COMMUTE_REQUESTS=30
RATE_LIMIT_COMMUTE_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=15
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true

# Security & Authentication
JWT_SECRET=insecure_dev_jwt_secret_key_change_in_production_min_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration (ollama | gemini | mock | auto)
AI_ENABLED=true
AI_PROVIDER=auto
AI_PRIMARY_PROVIDER=ollama
AI_FALLBACK_PROVIDER=gemini
AI_ROUTING_COMPLEXITY_THRESHOLD=3
AI_TOTAL_TIMEOUT_SECONDS=35.0

# Gemini Hosted Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=20.0
GEMINI_MAX_OUTPUT_TOKENS=1024

# Local Ollama Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=20.0
OLLAMA_KEEP_ALIVE=5m

# Frontend Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_DEFAULT_LAT=12.9716
NEXT_PUBLIC_MAP_DEFAULT_LNG=80.2458
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
